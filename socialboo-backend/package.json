{
  "name": "socialboo-backend",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "nest build",
    "deploy": "nest deploy",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start --env-file .env",
    "start:dev": "nest start --watch --env-file .env",
    "start:debug": "nest start --debug --watch --env-file .env",
    "start:prod": "node dist/main --env-file .env.prod",
    "lint": "oxlint --type-aware src/ test/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
    "auth:generate": "bun --env-file=.env run scripts/auth-generate.ts",
    "db:migrate": "bun drizzle-kit migrate",
    "db:push": "bun drizzle-kit push",
    "db:pull": "bun drizzle-kit pull",
    "db:generate": "bun drizzle-kit generate",
    "db:export": "bun drizzle-kit export"
  },
  "dependencies": {
    "@fastify/static": "latest",
    "@magicyan/discord": "^latest",
    "@nestjs/common": "latest",
    "@nestjs/config": "latest",
    "@nestjs/core": "latest",
    "@nestjs/platform-express": "latest",
    "@nestjs/platform-fastify": "latest",
    "@nestjs/swagger": "latest",
    "@scalar/nestjs-api-reference": "latest",
    "@thallesp/nestjs-better-auth": "latest",
    "chalk": "latest",
    "dotenv": "latest",
    "drizzle-orm": "latest",
    "nestjs-zod": "latest",
    "pg": "latest",
    "postgres": "latest",
    "reflect-metadata": "latest",
    "rxjs": "latest"
  },
  "devDependencies": {
    "@nestjs/cli": "latest",
    "@nestjs/mau": "latest",
    "@nestjs/schematics": "latest",
    "@nestjs/testing": "latest",
    "@types/express": "latest",
    "@types/node": "latest",
    "@types/pg": "latest",
    "@types/supertest": "latest",
    "@vitest/coverage-v8": "latest",
    "auth": "latest",
    "drizzle-kit": "latest",
    "oxlint": "latest",
    "oxlint-tsgolint": "latest",
    "prettier": "latest",
    "source-map-support": "latest",
    "supertest": "latest",
    "tsconfig-paths": "latest",
    "tsx": "latest",
    "typescript": "^6.0.3",
    "vite": "latest",
    "vitest": "latest"
  }
}
